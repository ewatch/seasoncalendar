{
	"name": "seasoncalendar",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && npm run pwa:generate-assets && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"pwa:generate-assets": "pwa-assets-generator --preset minimal public/logo.svg",
		"test": "node --import tsx --test \"tests/**/*.test.ts\""
	},
	"dependencies": {
		"@astrojs/alpinejs": "^1.0.0",
		"@astrojs/check": "^0.9.10",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@types/alpinejs": "^3.17.0",
		"alpinejs": "^3.17.4",
		"astro": "^7.4.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"workbox-window": "^7.4.1"
	},
	"devDependencies": {
		"@vite-pwa/assets-generator": "^2.0.0",
		"astro-icon": "^1.2.0",
		"astro-seo": "^1.2.0",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.30",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^0.14.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15"
	},
	"prettier": {
		"tabWidth": 4,
		"useTabs": true,
		"bracketSameLine": true,
		"printWidth": 150,
		"htmlWhitespaceSensitivity": "ignore",
		"plugins": [
			"prettier-plugin-astro",
			"prettier-plugin-tailwindcss"
		]
	}
}
