---
import { localizePath } from "@utils/t.ts";
import Link from "@components/Link.astro";

export interface Props {
	prevUrl: string;
	nextUrl: string;
	prevText?: string;
	nextText?: string;
	class?: string;
}

const url = Astro.url;

const { prevUrl, nextUrl, prevText = "Prev", nextText = "Next", class: className } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<div class:list={["container flex", className]}>
			<div class="flex flex-row mx-auto container justify-center gap-8">
				<Link href={localizePath(prevUrl, url)} style="muted" class={`${!prevUrl ? "invisible" : ""}`}>
					<div class="flex flex-row align-middle">
						<p class="ml-2">{prevText}</p>
					</div>
				</Link>
				<Link href={localizePath(nextUrl, url)} style="muted" class={`${!nextUrl ? "invisible" : ""}`}>
					<div class="flex flex-row align-middle">
						<span class="mr-2">{nextText}</span>
					</div>
				</Link>
			</div>
		</div>
	)
}
