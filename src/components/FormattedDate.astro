---
import { DEFAULT_LOCALE } from "@src/consts";

interface Props {
	date: Date;
	includeTime?: boolean;
}

const { date, includeTime } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(DEFAULT_LOCALE, {
			year: "numeric",
			month: "short",
			day: "numeric",
			hour: includeTime ? "numeric" : undefined,
			minute: includeTime ? "numeric" : undefined,
		})
	}
</time>
