---
import foodData from "@locales/de/food-calendar.json";
import { getAvailableInMonth, getCurrentMonth, getCurrentMonthDisplayName } from "@src/utils/foodFilter";

// Initial (current) month determined at build time – used for initial render only.
const currentMonth = getCurrentMonth();
const currentMonthDisplayName = getCurrentMonthDisplayName();
const currentYear = new Date().getFullYear();
const food = getAvailableInMonth(foodData, currentMonth);
---

<div class="max-w-6xl mx-auto p-6">
    <!-- Header Section -->
    <div class="text-center mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-lima-900 mb-2">
            Saisonkalender
        </h1>
        <div class="flex items-center justify-center gap-4 mb-4" aria-live="polite">
            <button id="prev-month" type="button" class="px-3 py-2 rounded border border-lima-300 text-lima-700 hover:bg-lima-100 focus:outline-none focus:ring-2 focus:ring-lima-400" aria-label="Vorheriger Monat">
                ←
            </button>
            <h2 id="month-title" class="text-2xl md:text-3xl font-semibold text-lima-700">
                {currentMonthDisplayName} {currentYear}
            </h2>
            <button id="next-month" type="button" class="px-3 py-2 rounded border border-lima-300 text-lima-700 hover:bg-lima-100 focus:outline-none focus:ring-2 focus:ring-lima-400" aria-label="Nächster Monat">
                →
            </button>
        </div>
        <p class="text-lima-600 text-lg">
            Frische, saisonale Produkte für diesen Monat
        </p>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Vegetables Card -->
        <div class="bg-green-50 border-2 border-green-200 rounded-lg p-6" data-category="vegetables">
            <div class="flex items-center mb-4">
                <span class="text-2xl mr-3">🥕</span>
                <h3 class="text-xl md:text-2xl font-bold text-green-800">Gemüse</h3>
            </div>
            <ul id="vegetables-list" class="space-y-2">
                {food.vegetables.map((vegetable) => (
                    <li class="text-gray-700">{vegetable.details.icon} {vegetable.name}</li>
                ))}
            </ul>
        </div>

        <!-- Fruits Card -->
        <div class="bg-orange-50 border-2 border-orange-200 rounded-lg p-6" data-category="fruits">
            <div class="flex items-center mb-4">
                <span class="text-2xl mr-3">🍎</span>
                <h3 class="text-xl md:text-2xl font-bold text-orange-800">Obst</h3>
            </div>
            <ul id="fruits-list" class="space-y-2">
                {food.fruits.map((fruit: string) => (
                    <li class="text-gray-700">{fruit}</li>
                ))}
            </ul>
        </div>

        <!-- Herbs Card -->
        <div class="bg-emerald-50 border-2 border-emerald-200 rounded-lg p-6" data-category="herbs">
            <div class="flex items-center mb-4">
                <span class="text-2xl mr-3">🌿</span>
                <h3 class="text-xl md:text-2xl font-bold text-emerald-800">Kräuter</h3>
            </div>
            <ul id="herbs-list" class="space-y-2">
                {food.herbs.map((herb: string) => (
                    <li class="text-gray-700">{herb}</li>
                ))}
            </ul>
        </div>

        <!-- Salads Card -->
        <div class="bg-lime-50 border-2 border-lime-200 rounded-lg p-6" data-category="salads">
            <div class="flex items-center mb-4">
                <span class="text-2xl mr-3">🥬</span>
                <h3 class="text-xl md:text-2xl font-bold text-lime-800">Salat</h3>
            </div>
            <ul id="salads-list" class="space-y-2">
                {food.salads.map((salad: string) => (
                    <li class="text-gray-700">{salad}</li>
                ))}
            </ul>
        </div>
    </div>
</div>

<!-- Embed the full food data for client-side navigation -->
<!-- Embedded season data for client-side month navigation -->
<script is:inline type="application/json" id="food-data" set:html={JSON.stringify(foodData)}></script>
<script>
	import { getAvailableInMonth, getCurrentMonth, getMonthDisplayName, getNextMonth, getPreviousMonth, getYearForMonth } from "@src/utils/foodFilter";

	function updateList<T>(listElement: HTMLElement | null, items: T[], renderText: (item: T) => string): void {
		if (!listElement) {
			return;
		}

		listElement.innerHTML = "";
		items.forEach((item) => {
			const li = document.createElement("li");
			li.className = "text-gray-700";
			li.textContent = renderText(item);
			listElement.appendChild(li);
		});
	}

	function updateMonthDisplay(monthAbbr: string, year: number, seasonData: Parameters<typeof getAvailableInMonth>[0]): void {
		const monthTitle = document.getElementById("month-title");
		if (monthTitle) {
			monthTitle.textContent = `${getMonthDisplayName(monthAbbr)} ${year}`;
		}

		const food = getAvailableInMonth(seasonData, monthAbbr);

		updateList(document.getElementById("vegetables-list"), food.vegetables, (vegetable) => `${vegetable.details.icon} ${vegetable.name}`.trim());
		updateList(document.getElementById("fruits-list"), food.fruits, (fruit) => fruit);
		updateList(document.getElementById("herbs-list"), food.herbs, (herb) => herb);
		updateList(document.getElementById("salads-list"), food.salads, (salad) => salad);
	}

	document.addEventListener("DOMContentLoaded", () => {
		const foodDataScript = document.getElementById("food-data");
		if (!foodDataScript) {
			return;
		}

		const textContent = foodDataScript.textContent || "";
		if (!textContent.trim()) {
			return;
		}

		let seasonData: Parameters<typeof getAvailableInMonth>[0];
		try {
			seasonData = JSON.parse(textContent) as Parameters<typeof getAvailableInMonth>[0];
		} catch {
			return;
		}

		let currentDisplayedMonth = getCurrentMonth();
		let currentDisplayedYear = new Date().getFullYear();

		const prevButton = document.getElementById("prev-month");
		const nextButton = document.getElementById("next-month");

		if (!prevButton || !nextButton) {
			return;
		}

		prevButton.addEventListener("click", () => {
			const previousMonth = getPreviousMonth(currentDisplayedMonth);
			currentDisplayedYear = getYearForMonth(previousMonth, currentDisplayedMonth, currentDisplayedYear);
			currentDisplayedMonth = previousMonth;
			updateMonthDisplay(currentDisplayedMonth, currentDisplayedYear, seasonData);
		});

		nextButton.addEventListener("click", () => {
			const nextMonth = getNextMonth(currentDisplayedMonth);
			currentDisplayedYear = getYearForMonth(nextMonth, currentDisplayedMonth, currentDisplayedYear);
			currentDisplayedMonth = nextMonth;
			updateMonthDisplay(currentDisplayedMonth, currentDisplayedYear, seasonData);
		});
	});
</script>
