---
import foodData from "@locales/de/food-calendar.json";
import { getAvailableInMonth, getCurrentMonth, getCurrentMonthDisplayName } from "@src/utils/foodFilter";

const SHOW_SEASON_FILTER = true;

const currentMonth = getCurrentMonth();
const currentMonthDisplayName = getCurrentMonthDisplayName();
const food = getAvailableInMonth(foodData, currentMonth);

const statusLabel = {
	freiland: "Freiland",
	lager: "Lager",
	both: "Freiland + Lager",
} as const;

function getStatusDotClass(type: keyof typeof statusLabel): string {
	if (type === "freiland") {
		return "bg-lima-400";
	}

	if (type === "both") {
		return "bg-amber-300";
	}

	return "bg-stone-300";
}
---

<div id="food-month-root" class="max-w-5xl mx-auto px-4 py-8 md:py-12 sm:px-6 lg:px-8 bg-paper min-h-screen">
    <header class="mb-12 md:mb-16 text-center">
        <span class="inline-block text-stone-500 uppercase tracking-[0.2em] text-[10px] md:text-xs font-semibold mb-4">
            Der Saisonale Kalender
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-serif text-stone-900 mb-6 md:mb-8 leading-tight">
            Was wächst im <span id="month-title-main" class="italic text-lima-800">{currentMonthDisplayName}</span>?
        </h1>

        <div class="flex items-center justify-between sm:justify-center gap-4 sm:gap-8 border-y border-stone-200 py-4 md:py-6">
            <button id="prev-month" type="button" class="group flex items-center gap-2 text-stone-400 hover:text-stone-900 transition-colors" aria-label="Vorheriger Monat">
                <span class="text-xl md:text-2xl group-hover:-translate-x-1 transition-transform">←</span>
                <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider">Zurück</span>
            </button>

            <div id="month-title" class="text-base md:text-lg font-serif italic text-stone-600 min-w-[120px] md:min-w-[150px]">
                {currentMonthDisplayName}
            </div>

            <button id="next-month" type="button" class="group flex items-center gap-2 text-stone-400 hover:text-stone-900 transition-colors" aria-label="Nächster Monat">
                <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider">Weiter</span>
                <span class="text-xl md:text-2xl group-hover:translate-x-1 transition-transform">→</span>
            </button>
        </div>

        {
            SHOW_SEASON_FILTER && (
                <div class="mt-5 flex items-center justify-center gap-2" id="season-filter-toggle" aria-label="Saison-Filter">
                    <button id="filter-all" type="button" class="rounded-full border border-stone-300 bg-stone-900 text-paper px-3 py-1 text-[10px] uppercase tracking-wider transition-colors" aria-pressed="true">
                        Alle saisonal
                    </button>
                    <button id="filter-freiland" type="button" class="rounded-full border border-stone-300 bg-transparent text-stone-500 px-3 py-1 text-[10px] uppercase tracking-wider transition-colors" aria-pressed="false">
                        Nur Freiland
                    </button>
                    <button id="filter-lager" type="button" class="rounded-full border border-stone-300 bg-transparent text-stone-500 px-3 py-1 text-[10px] uppercase tracking-wider transition-colors" aria-pressed="false">
                        Nur Lager
                    </button>
                </div>
            )
        }
        <div id="season-status-legend" class="mt-3 flex items-center justify-center gap-4 text-[10px] uppercase tracking-wider text-stone-500">
            <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-lima-400"></span> Freiland</span>
            <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span> Lager</span>
            <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-amber-300"></span> Beides</span>
        </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12 lg:gap-8">
        <section class="flex flex-col" data-category="vegetables">
            <div class="flex items-baseline gap-3 mb-6 border-b border-stone-100 pb-2">
                <span class="text-stone-300 font-serif italic text-2xl">01</span>
                <h3 class="text-xl font-serif text-stone-800">Gemüse</h3>
            </div>
            <ul id="vegetables-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-y-3 gap-x-4">
                {food.vegetables.map((vegetable) => (
                    <li class="flex items-start gap-3 text-stone-600 group hover:text-lima-800 transition-colors cursor-default">
                        <span class="opacity-40 group-hover:opacity-100 transition-opacity shrink-0 mt-0.5">{vegetable.details.icon}</span>
                        <span class="flex w-full min-w-0 items-center justify-between gap-2">
                            <span class="text-sm tracking-wide truncate max-w-[84%]">{vegetable.name}</span>
                            <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", getStatusDotClass(vegetable.availabilityType)]} title={statusLabel[vegetable.availabilityType]}></span>
                        </span>
                    </li>
                ))}
            </ul>
        </section>

        <section class="flex flex-col" data-category="fruits">
            <div class="flex items-baseline gap-3 mb-6 border-b border-stone-100 pb-2">
                <span class="text-stone-300 font-serif italic text-2xl">02</span>
                <h3 class="text-xl font-serif text-stone-800">Obst</h3>
            </div>
            <ul id="fruits-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-y-3 gap-x-4">
                {food.fruits.map((fruit) => (
                    <li class="flex items-start gap-3 text-stone-600 group hover:text-lima-800 transition-colors cursor-default">
                        <span class="w-1.5 h-1.5 rounded-full bg-stone-200 group-hover:bg-lima-400 transition-colors shrink-0 mt-2"></span>
                        <span class="flex w-full min-w-0 items-center justify-between gap-2">
                            <span class="text-sm tracking-wide truncate max-w-[84%]">{fruit.name}</span>
                            <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", getStatusDotClass(fruit.availabilityType)]} title={statusLabel[fruit.availabilityType]}></span>
                        </span>
                    </li>
                ))}
            </ul>
        </section>

        <section class="flex flex-col" data-category="salads">
            <div class="flex items-baseline gap-3 mb-6 border-b border-stone-100 pb-2">
                <span class="text-stone-300 font-serif italic text-2xl">03</span>
                <h3 class="text-xl font-serif text-stone-800">Salate</h3>
            </div>
            <ul id="salads-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-y-3 gap-x-4">
                {food.salads.map((salad) => (
                    <li class="flex items-start gap-3 text-stone-600 group hover:text-lima-800 transition-colors cursor-default">
                        <span class="w-1.5 h-1.5 rounded-full bg-stone-200 group-hover:bg-lima-400 transition-colors shrink-0 mt-2"></span>
                        <span class="flex w-full min-w-0 items-center justify-between gap-2">
                            <span class="text-sm tracking-wide truncate max-w-[84%]">{salad.name}</span>
                            <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", getStatusDotClass(salad.availabilityType)]} title={statusLabel[salad.availabilityType]}></span>
                        </span>
                    </li>
                ))}
            </ul>
        </section>

        <section class="flex flex-col" data-category="herbs">
            <div class="flex items-baseline gap-3 mb-6 border-b border-stone-100 pb-2">
                <span class="text-stone-300 font-serif italic text-2xl">04</span>
                <h3 class="text-xl font-serif text-stone-800">Kräuter</h3>
            </div>
            <ul id="herbs-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-y-3 gap-x-4">
                {food.herbs.map((herb) => (
                    <li class="flex items-start gap-3 text-stone-600 group hover:text-lima-800 transition-colors cursor-default">
                        <span class="w-1.5 h-1.5 rounded-full bg-stone-200 group-hover:bg-lima-400 transition-colors shrink-0 mt-2"></span>
                        <span class="flex w-full min-w-0 items-center justify-between gap-2">
                            <span class="text-sm tracking-wide truncate max-w-[84%]">{herb.name}</span>
                            <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", getStatusDotClass(herb.availabilityType)]} title={statusLabel[herb.availabilityType]}></span>
                        </span>
                    </li>
                ))}
            </ul>
        </section>
    </div>

    <footer class="mt-24 pt-12 border-t border-stone-100 text-center">
        <p class="text-stone-400 text-xs uppercase tracking-widest leading-relaxed max-w-lg mx-auto">
            Genieße, was die Natur uns schenkt. Saisonaler Konsum unterstützt lokale Bauern und schützt unsere Umwelt.
        </p>
    </footer>
</div>

<script is:inline type="application/json" id="food-data" set:html={JSON.stringify(foodData)}></script>

<script>
	import { getAvailableInMonth, getCurrentMonth, getMonthDisplayName, getNextMonth, getPreviousMonth } from "@src/utils/foodFilter";

	const SHOW_SEASON_FILTER = true;

	const dotStyles = {
		freiland: "bg-lima-400",
		lager: "bg-stone-300",
		both: "bg-amber-300",
	};

	const dotLabels = {
		freiland: "Freiland",
		lager: "Lager",
		both: "Freiland + Lager",
	};

	function renderAvailabilityDot(type: keyof typeof dotStyles, filterMode: "all" | "freiland" | "lager"): string {
		if (filterMode !== "all") {
			return "";
		}

		const style = dotStyles[type] ?? dotStyles.lager;
		const label = dotLabels[type] ?? dotLabels.lager;
		return `<span class="h-2.5 w-2.5 shrink-0 rounded-full ${style}" title="${label}"></span>`;
	}

	function updateList<T>(listElement: HTMLElement | null, items: T[], renderFn: (item: T) => string): void {
		if (!listElement) return;

		listElement.innerHTML = "";

		if (items.length === 0) {
			const li = document.createElement("li");
			li.className = "text-stone-400 text-xs italic col-span-2";
			li.textContent = "Keine Auswahl verfügbar";
			listElement.appendChild(li);
			return;
		}

		items.forEach((item) => {
			const li = document.createElement("li");
			li.className = "flex items-start gap-3 text-stone-600 group hover:text-lima-800 transition-colors cursor-default";
			li.innerHTML = renderFn(item);
			listElement.appendChild(li);
		});
	}

	function applyFilterButtonStyles(filterMode: "all" | "freiland" | "lager"): void {
		if (!SHOW_SEASON_FILTER) return;
		const allButton = document.getElementById("filter-all");
		const freilandButton = document.getElementById("filter-freiland");
		const lagerButton = document.getElementById("filter-lager");
		const legend = document.getElementById("season-status-legend");

		if (!allButton || !freilandButton || !lagerButton) return;

		const baseClass = "rounded-full border border-stone-300 bg-transparent text-stone-500 px-3 py-1 text-[10px] uppercase tracking-wider transition-colors";
		const activeClass = "rounded-full border border-stone-300 bg-stone-900 text-paper px-3 py-1 text-[10px] uppercase tracking-wider transition-colors";

		allButton.className = filterMode === "all" ? activeClass : baseClass;
		freilandButton.className = filterMode === "freiland" ? activeClass : baseClass;
		lagerButton.className = filterMode === "lager" ? activeClass : baseClass;

		allButton.setAttribute("aria-pressed", String(filterMode === "all"));
		freilandButton.setAttribute("aria-pressed", String(filterMode === "freiland"));
		lagerButton.setAttribute("aria-pressed", String(filterMode === "lager"));

		if (legend) {
			legend.classList.toggle("hidden", filterMode !== "all");
		}
	}

	function updateMonthDisplay(monthAbbr: string, seasonData: Parameters<typeof getAvailableInMonth>[0], filterMode: "all" | "freiland" | "lager"): void {
		const monthTitle = document.getElementById("month-title");
		const monthTitleMain = document.getElementById("month-title-main");
		const displayName = getMonthDisplayName(monthAbbr);

		if (monthTitle) {
			monthTitle.textContent = displayName;
		}
		if (monthTitleMain) {
			monthTitleMain.textContent = displayName;
		}

		const food = getAvailableInMonth(seasonData, monthAbbr, {
			onlyFreiland: filterMode === "freiland",
			onlyLager: filterMode === "lager",
		});

		updateList(document.getElementById("vegetables-list"), food.vegetables, (v) => `
            <span class="opacity-40 group-hover:opacity-100 transition-opacity shrink-0 mt-0.5">${v.details.icon || ""}</span>
            <span class="flex w-full min-w-0 items-center justify-between gap-2">
                <span class="text-sm tracking-wide truncate max-w-[84%]">${v.name}</span>
                ${renderAvailabilityDot(v.availabilityType, filterMode)}
            </span>
        `);
		updateList(document.getElementById("fruits-list"), food.fruits, (f) => `
            <span class="w-1.5 h-1.5 rounded-full bg-stone-200 group-hover:bg-lima-400 transition-colors shrink-0 mt-2"></span>
            <span class="flex w-full min-w-0 items-center justify-between gap-2">
                <span class="text-sm tracking-wide truncate max-w-[84%]">${f.name}</span>
                ${renderAvailabilityDot(f.availabilityType, filterMode)}
            </span>
        `);
		updateList(document.getElementById("herbs-list"), food.herbs, (h) => `
            <span class="w-1.5 h-1.5 rounded-full bg-stone-200 group-hover:bg-lima-400 transition-colors shrink-0 mt-2"></span>
            <span class="flex w-full min-w-0 items-center justify-between gap-2">
                <span class="text-sm tracking-wide truncate max-w-[84%]">${h.name}</span>
                ${renderAvailabilityDot(h.availabilityType, filterMode)}
            </span>
        `);
		updateList(document.getElementById("salads-list"), food.salads, (s) => `
            <span class="w-1.5 h-1.5 rounded-full bg-stone-200 group-hover:bg-lima-400 transition-colors shrink-0 mt-2"></span>
            <span class="flex w-full min-w-0 items-center justify-between gap-2">
                <span class="text-sm tracking-wide truncate max-w-[84%]">${s.name}</span>
                ${renderAvailabilityDot(s.availabilityType, filterMode)}
            </span>
        `);

		applyFilterButtonStyles(filterMode);
	}

	function initSeasonCalendar(): void {
		const root = document.getElementById("food-month-root");
		if (!root || root.dataset.initialized === "true") {
			return;
		}
		root.dataset.initialized = "true";

		const foodDataScript = document.getElementById("food-data");
		if (!foodDataScript) return;

		const textContent = foodDataScript.textContent || "";
		if (!textContent.trim()) return;

		let seasonData: any;
		try {
			seasonData = JSON.parse(textContent);
		} catch {
			return;
		}

		let currentDisplayedMonth = getCurrentMonth();
		let filterMode: "all" | "freiland" | "lager" = "all";

		const prevButton = root.querySelector<HTMLElement>("#prev-month");
		const nextButton = root.querySelector<HTMLElement>("#next-month");
		const allButton = root.querySelector<HTMLElement>("#filter-all");
		const freilandButton = root.querySelector<HTMLElement>("#filter-freiland");
		const lagerButton = root.querySelector<HTMLElement>("#filter-lager");

		if (!prevButton || !nextButton) return;

		updateMonthDisplay(currentDisplayedMonth, seasonData, filterMode);

		prevButton.addEventListener("click", () => {
			const previousMonth = getPreviousMonth(currentDisplayedMonth);
			currentDisplayedMonth = previousMonth;
			updateMonthDisplay(currentDisplayedMonth, seasonData, filterMode);
		});

		nextButton.addEventListener("click", () => {
			const nextMonth = getNextMonth(currentDisplayedMonth);
			currentDisplayedMonth = nextMonth;
			updateMonthDisplay(currentDisplayedMonth, seasonData, filterMode);
		});

		if (SHOW_SEASON_FILTER && allButton && freilandButton && lagerButton) {
			allButton.addEventListener("click", () => {
				filterMode = "all";
				updateMonthDisplay(currentDisplayedMonth, seasonData, filterMode);
			});

			freilandButton.addEventListener("click", () => {
				filterMode = "freiland";
				updateMonthDisplay(currentDisplayedMonth, seasonData, filterMode);
			});

			lagerButton.addEventListener("click", () => {
				filterMode = "lager";
				updateMonthDisplay(currentDisplayedMonth, seasonData, filterMode);
			});
		}
	}

	document.addEventListener("DOMContentLoaded", initSeasonCalendar);
	document.addEventListener("astro:page-load", initSeasonCalendar);
</script>

<style>
    .font-serif {
        font-family: Georgia, serif;
    }
</style>
