---
import LanguageSelector from "@components/LanguageSelector.astro";
import HeaderLink from "@components/Link.astro";
import ThemeSelector from "@components/ThemeSelector.astro";
import { PAGES, SITE_TITLE } from "@src/consts";
import { localizePath } from "@utils/t.ts";
import { tFn } from "@utils/t.ts";

const url = Astro.url;
const t = tFn(Astro.url);
---

<header
	x-data="{ open: false }"
	class="w-full bg-paper/80 backdrop-blur-sm sticky top-0 z-50 border-b border-stone-100">
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-20">
			<!-- Logo -->
			<div class="flex-shrink-0">
				<a href={localizePath("/", url)}
					class="font-serif italic text-2xl text-stone-900 tracking-tight hover:text-lima-800 transition-colors">
					{SITE_TITLE}
				</a>
			</div>

			<!-- Desktop Navigation -->
			<nav class="hidden md:flex items-center space-x-8">
				{PAGES.map((item) => (
					<HeaderLink href={item.href} class="text-xs uppercase tracking-widest text-stone-500 hover:text-stone-900 transition-colors font-medium">
						{t(item.title)}
					</HeaderLink>
				))}
				<div class="flex items-center pl-4 border-l border-stone-200 ml-4 space-x-6">
					<LanguageSelector />
					<ThemeSelector />
				</div>
			</nav>

			<!-- Mobile menu button -->
			<div class="md:hidden flex items-center">
				<button @click="open = !open" class="text-stone-500 hover:text-stone-900 focus:outline-none p-2">
					<span class="sr-only">Menu</span>
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path x-show="!open" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
						<path x-show="open" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Navigation -->
	<div 
		x-show="open" 
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-4"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-4"
		class="md:hidden bg-paper border-b border-stone-100 pb-6 px-4">
		<div class="flex flex-col space-y-4">
			{PAGES.map((item) => (
				<HeaderLink href={item.href} class="text-sm uppercase tracking-widest text-stone-600 font-medium py-2 border-b border-stone-50">
					{t(item.title)}
				</HeaderLink>
			))}
			<div class="pt-4 flex items-center justify-between border-t border-stone-50">
				<LanguageSelector />
				<ThemeSelector />
			</div>
		</div>
	</div>
</header>
