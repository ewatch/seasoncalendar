---
import { ClientRouter } from "astro:transitions";
import BaseHead from "@components/BaseHead.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_LOCALE } from "@src/consts";

// replaced dynamically
const buildDate = new Date(__DATE__);

type Props = {
	title?: string;
	description?: string;
	image?: string;
};

const { image, title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props as Props;
---

<html lang={DEFAULT_LOCALE}>
	<head>
		<BaseHead title={title} description={description} image={image} />
		{/* Comment the line below if you want to remove client side routing */}
		<ClientRouter />
	</head>

	<body class="bg-paper transition-colors duration-500">
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer {buildDate} />
	</body>
</html>
