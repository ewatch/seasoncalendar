---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 | Seite nicht gefunden">
	<section class="mx-auto max-w-xl px-4 py-24 text-center">
		<span class="mb-4 inline-block text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-500 md:text-xs">Fehler 404</span>
		<h1 class="mb-6 font-serif text-4xl leading-tight text-stone-900 sm:text-5xl">
			Diese Seite ist <span class="italic text-lima-800">nicht in Saison</span>.
		</h1>
		<p class="mb-10 text-stone-600">Die Seite gibt es leider nicht. Auf der Startseite findest du, was gerade Saison hat.</p>
		<a
			href="/"
			class="inline-block border border-stone-900 bg-stone-900 px-5 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-paper transition-colors hover:bg-lima-800">
			Zur Startseite
		</a>
	</section>
</Layout>
